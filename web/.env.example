# Supabase project settings. Configure confirmation and recovery email
# templates in Supabase Auth, not in this application.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cysmo provider credentials. These are server-only and never stored in the database.
CYSMO_API_BASE_URL=https://api.cysmo.com
CYSMO_CLIENT_ID=
CYSMO_CLIENT_SECRET=

# PANTA CYBER breach-query credentials. These are server-only and never stored in the database.
PANTA_API_BASE_URL=https://api.moses-security.de
PANTA_API_KEY=

# Public callback origin for Supabase confirmation and recovery links.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# External/manual worker invocations use Authorization: Bearer <secret>.
CRON_SECRET=

# Per-user quota.
DOMAIN_CHECK_MAX_PER_USER=10

# The Vercel build ensures this account exists and has the admin role whenever
# both values are configured. Never commit these values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
