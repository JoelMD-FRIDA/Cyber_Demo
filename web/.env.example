# Server-only runtime configuration. Never pass secrets as Docker build arguments.
DATABASE_URL=
ASSET_DIRECTORY=/app/assets
APP_ORIGIN=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REQUIRED_ENTITLEMENT_CLAIM=
OIDC_REQUIRED_ENTITLEMENT_VALUE=
# Base64-encoded 32-byte key, delivered through the server secret store.
SESSION_ENCRYPTION_KEY=
CYSMO_API_BASE_URL=
CYSMO_CLIENT_ID=
CYSMO_CLIENT_SECRET=
PANTA_API_BASE_URL=https://api.moses-security.de
PANTA_API_KEY=
# Absent means the private scheduler endpoint denies every call.
CRON_SECRET=
DOMAIN_CHECK_MAX_PER_USER=10
DOMAIN_CHECK_POLL_INTERVAL_SECONDS=5

# Read-only private deployment probe: separate from browser login and cron.
DEPLOYMENT_PROBE_SECRET=
DEPLOYMENT_PROBE_PROFILE_ID=
